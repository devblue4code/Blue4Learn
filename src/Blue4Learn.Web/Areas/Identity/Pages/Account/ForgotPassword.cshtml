@page
@model Blue4Learn.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar senha";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<p class="auth-eyebrow">Segurança</p>
<h1 class="auth-title">Esqueceu a senha?</h1>
<p class="auth-subtitle">Informe o e-mail da conta. Se ele existir, enviaremos um link para redefinição.</p>

<form method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus
               placeholder="voce@escola.edu.br" />
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>
    <div class="auth-actions">
        <button type="submit" class="btn btn-primary auth-submit w-100">Enviar link</button>
        <div class="auth-links">
            <a asp-page="./Login">Voltar ao login</a>
        </div>
    </div>
</form>

<p class="small text-muted mt-4 mb-0">
    No protótipo, o e-mail é gravado em <code>App_Data/email-outbox.txt</code>.
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
