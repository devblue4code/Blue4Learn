@page
@model Blue4Learn.Web.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Link enviado";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<p class="auth-eyebrow">Pronto</p>
<h1 class="auth-title">Verifique o e-mail</h1>
<div class="auth-success">
    Se o endereço existir na plataforma, o link de redefinição já foi preparado.
    No ambiente de desenvolvimento, abra <code>App_Data/email-outbox.txt</code>.
</div>
<div class="auth-links mt-4">
    <a asp-page="./Login">Voltar ao login</a>
</div>
