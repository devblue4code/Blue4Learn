@page
@model Blue4Learn.Web.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Senha atualizada";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<p class="auth-eyebrow">Pronto</p>
<h1 class="auth-title">Senha redefinida</h1>
<div class="auth-success">
    Sua senha foi atualizada. Você já pode entrar no Blue4Learn.
</div>
<div class="auth-links mt-4">
    <a class="btn btn-primary auth-submit" asp-page="./Login">Ir para o login</a>
</div>
