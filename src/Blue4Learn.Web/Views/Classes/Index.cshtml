@model ClassListViewModel
@{
    ViewData["Title"] = "Turmas";
    ViewData["ShowCrumbs"] = true;
    ViewData["CrumbParent"] = "Gestão de cursos";
    ViewData["CrumbCurrent"] = "Turmas";
}

<div class="page-header">
    <div>
        <p class="eyebrow">Gestão</p>
        <h1>Turmas</h1>
        <p class="section-lead">Crie turmas, compartilhe o código e matricule estudantes ou professoras.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-plus-lg me-1"></i> Nova turma
    </a>
</div>

@if (!Model.Classes.Any())
{
    <div class="soft-panel">
        <p class="mb-0 text-muted">Nenhuma turma ainda. Crie a primeira para organizar a disciplina.</p>
    </div>
}
else
{
    <div class="data-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Turma</th>
                        <th>Código</th>
                        <th>Disciplina</th>
                        <th>Membros</th>
                        <th>Estudantes</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Classes)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <strong class="text-body">@item.Name</strong>
                                @if (item.IsMember)
                                {
                                    <span class="member-pill">Você está nela</span>
                                }
                            </div>
                        </td>
                        <td>
                            <span class="code-chip">
                                @item.Code
                                <button type="button" class="btn btn-link p-0 border-0 text-danger" data-copy-code="@item.Code" title="Copiar código" aria-label="Copiar código">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </span>
                        </td>
                        <td class="text-uppercase fw-medium">@item.CourseTitle</td>
                        <td>@item.MemberCount</td>
                        <td>@item.StudentCount</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@item.Id">Membros</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="data-card-footer">
            <span>Mostrando @Model.Classes.Count de @Model.Classes.Count turma@(Model.Classes.Count == 1 ? "" : "s")</span>
            <div class="d-flex gap-1">
                <span class="btn btn-sm btn-primary" style="min-width:2rem">1</span>
            </div>
        </div>
    </div>
}
