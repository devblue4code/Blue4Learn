@model ContentLibraryViewModel
@{
    ViewData["Title"] = "Conteúdos da turma";
    ViewData["ShowCrumbs"] = true;
    ViewData["CrumbParent"] = "Gestão de cursos";
    ViewData["CrumbCurrent"] = "Conteúdos";
}

<div class="page-header">
    <div>
        <p class="eyebrow">@Model.CourseTitle</p>
        <h1>Conteúdos da turma</h1>
        <p class="section-lead">Escreva em Markdown, defina conceitos e publique quando a aula estiver pronta.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" asp-controller="Courses" asp-action="Index">Componentes</a>
        <a class="btn btn-primary" asp-action="Create">Nova aula</a>
    </div>
</div>

@if (!Model.Lessons.Any())
{
    <div class="soft-panel dash-empty">
        <h3>Nenhuma aula cadastrada</h3>
        <p class="mb-0 text-muted">Crie a primeira a partir de um Markdown e monte os conceitos do diário.</p>
        <a class="btn btn-primary mt-3" asp-action="Create">Nova aula</a>
    </div>
}
else
{
    <div class="pub-lesson-list">
        @foreach (var lesson in Model.Lessons)
        {
            <article class="soft-panel pub-lesson-card">
                <div class="pub-lesson-main">
                    <div class="pub-lesson-top">
                        <span class="lesson-order">@lesson.SortOrder</span>
                        <span class="status-pill status-@lesson.Status.ToString().ToLowerInvariant()">
                            @StatusLabel(lesson.Status)
                        </span>
                    </div>
                    <h2>@lesson.Title</h2>
                    <p class="text-muted mb-2">@lesson.ModuleTitle · <code>@lesson.Slug</code></p>
                    <div class="pub-concept-row">
                        @if (lesson.ConceptNames.Any())
                        {
                            @foreach (var name in lesson.ConceptNames)
                            {
                                <span class="prog-chip">@name</span>
                            }
                        }
                        else
                        {
                            <span class="prog-chip is-muted">Sem conceitos</span>
                        }
                    </div>
                    <p class="small text-muted mb-0 mt-2">
                        Atualizado @(lesson.UpdatedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                    </p>
                </div>

                <div class="pub-icon-actions" role="group" aria-label="Ações da aula">
                    <a class="pub-icon-btn"
                       asp-action="Edit"
                       asp-route-id="@lesson.Id"
                       data-bs-toggle="tooltip"
                       data-bs-placement="top"
                       title="Editar aula">
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/></svg>
                        <span class="visually-hidden">Editar</span>
                    </a>

                    @if (lesson.Status == ContentStatus.Published)
                    {
                        <a class="pub-icon-btn"
                           asp-controller="Lessons"
                           asp-action="Workspace"
                           asp-route-id="@lesson.Id"
                           data-bs-toggle="tooltip"
                           data-bs-placement="top"
                           title="Ver como estudante">
                            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/></svg>
                            <span class="visually-hidden">Ver aula</span>
                        </a>
                        <form asp-action="SetStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@lesson.Id" />
                            <input type="hidden" name="status" value="@ContentStatus.Draft" />
                            <button type="submit"
                                    class="pub-icon-btn"
                                    data-bs-toggle="tooltip"
                                    data-bs-placement="top"
                                    title="Tornar rascunho">
                                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/></svg>
                                <span class="visually-hidden">Tornar rascunho</span>
                            </button>
                        </form>
                    }
                    else if (lesson.Status == ContentStatus.Draft)
                    {
                        <form asp-action="SetStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@lesson.Id" />
                            <input type="hidden" name="status" value="@ContentStatus.Published" />
                            <button type="submit"
                                    class="pub-icon-btn is-accent"
                                    data-bs-toggle="tooltip"
                                    data-bs-placement="top"
                                    title="Publicar aula">
                                <svg viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M4.406 1.342A5.53 5.53 0 0 1 8 0c2.69 0 4.923 2 5.166 4.579C14.758 4.804 16 6.137 16 7.773 16 9.569 14.502 11 12.687 11H10a.5.5 0 0 1 0-1h2.688C13.979 10 15 8.988 15 7.773c0-1.216-1.02-2.228-2.313-2.228h-.5v-.5C12.188 2.825 10.328 1 8 1a4.53 4.53 0 0 0-2.941 1.1c-.456.36-.81.85-1.036 1.41l-.1.29-.29-.1A2.5 2.5 0 0 0 2.5 7.5c0 1.141.846 2.093 1.943 2.252A.5.5 0 0 1 4.5 10.5h.5a.5.5 0 0 1 0 1h-.5A3.5 3.5 0 0 1 1 8a3.5 3.5 0 0 1 2.406-3.326.5.5 0 0 1 .594.342l.1.29.29-.1c.226-.56.58-1.05 1.036-1.41z"/><path fill-rule="evenodd" d="M7.646 4.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 5.707V14.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708l3-3z"/></svg>
                                <span class="visually-hidden">Publicar</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="SetStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@lesson.Id" />
                            <input type="hidden" name="status" value="@ContentStatus.Draft" />
                            <button type="submit"
                                    class="pub-icon-btn"
                                    data-bs-toggle="tooltip"
                                    data-bs-placement="top"
                                    title="Restaurar como rascunho">
                                <svg viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2v1z"/><path d="M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466z"/></svg>
                                <span class="visually-hidden">Restaurar rascunho</span>
                            </button>
                        </form>
                    }

                    @if (lesson.Status != ContentStatus.Archived)
                    {
                        <form asp-action="SetStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@lesson.Id" />
                            <input type="hidden" name="status" value="@ContentStatus.Archived" />
                            <button type="submit"
                                    class="pub-icon-btn is-quiet"
                                    data-bs-toggle="tooltip"
                                    data-bs-placement="top"
                                    title="Arquivar aula">
                                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M0 2a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1v7.5a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 1 12.5V5a1 1 0 0 1-1-1V2zm2 3v7.5A1.5 1.5 0 0 0 3.5 14h9a1.5 1.5 0 0 0 1.5-1.5V5H2zm13-3H1v2h14V2zM5 7.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/></svg>
                                <span class="visually-hidden">Arquivar</span>
                            </button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach((el) => {
            bootstrap.Tooltip.getOrCreateInstance(el, { trigger: 'hover focus' });
        });
    </script>
}

@functions {
    private static string StatusLabel(ContentStatus status) => status switch
    {
        ContentStatus.Published => "Publicado",
        ContentStatus.Archived => "Arquivado",
        _ => "Rascunho"
    };
}
