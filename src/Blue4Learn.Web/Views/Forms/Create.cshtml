@model FormCreateViewModel
@{
    ViewData["Title"] = "Nova atividade";
    ViewData["TopTitle"] = "Atividades";
}

<div class="page-header">
    <div>
        <p class="eyebrow">Construtor</p>
        <h1>Nova atividade</h1>
        <p class="section-lead">Vincule a uma aula. Depois você monta as perguntas.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index">Voltar</a>
</div>

<form asp-action="Create" method="post" class="soft-panel" style="max-width: 640px">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="LessonId" class="form-label">Aula</label>
        <select asp-for="LessonId" class="form-select">
            <option value="">Selecione…</option>
            @foreach (var l in Model.Lessons)
            {
                if (Model.LessonId == l.Id)
                {
                    <option value="@l.Id" selected>@l.Label</option>
                }
                else
                {
                    <option value="@l.Id">@l.Label</option>
                }
            }
        </select>
        <span asp-validation-for="LessonId" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="Ex.: Check-in da sprint 2" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"
                  placeholder="Contexto opcional para o aluno"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Criar e montar perguntas</button>
</form>
