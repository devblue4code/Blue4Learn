@model FormFillViewModel
@{
    ViewData["Title"] = Model.IsTeacherPreview ? $"Preview · {Model.Title}" : Model.Title;
    ViewData["TopTitle"] = "Questionário";
    var showResults = Model.ShowResults && !Model.IsTeacherPreview;
    var isLocked = Model.IsLocked;
    var isTimedRun = !Model.IsTeacherPreview && !isLocked;
    var total = Model.Questions.Count;
    var seconds = Model.SecondsPerQuestion;
    string TypeHint(FormQuestionType t) => t switch
    {
        FormQuestionType.ShortText => "Resposta curta",
        FormQuestionType.Paragraph => "Resposta longa",
        FormQuestionType.SingleChoice => "Escolha uma opção",
        FormQuestionType.MultiChoice => "Pode marcar mais de uma",
        _ => ""
    };
}

<div class="form-fill-page"
     data-seconds="@seconds"
     data-timed="@(isTimedRun ? "true" : "false")"
     data-locked="@(isLocked ? "true" : "false")">
    <div class="page-header form-fill-header">
        <div>
            <p class="eyebrow">@Model.LessonContext</p>
            <h1>@Model.Title</h1>
            <p class="section-lead mb-1">
                <span class="text-muted">@Model.LessonTitle</span>
                @if (total > 0)
                {
                    <span class="form-fill-count">· @total pergunta@(total == 1 ? "" : "s")</span>
                }
                @if (isTimedRun)
                {
                    <span class="form-fill-count">· @seconds s por pergunta · 1 tentativa</span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="form-fill-desc">@Model.Description</p>
            }
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (Model.IsTeacherPreview)
            {
                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.FormId">Construtor</a>
                <a class="btn btn-outline-primary" asp-controller="Lessons" asp-action="Workspace" asp-route-id="@Model.LessonId">Ver aula</a>
            }
            else
            {
                <a class="btn btn-outline-primary" asp-controller="Lessons" asp-action="Workspace" asp-route-id="@Model.LessonId">Voltar à aula</a>
            }
            <a class="btn btn-outline-primary" asp-action="Index" asp-route-lessonId="@Model.LessonId">Lista</a>
        </div>
    </div>

    @if (Model.IsTeacherPreview)
    {
        <div class="form-fill-banner is-preview" role="status">
            <i class="bi bi-eye" aria-hidden="true"></i>
            <div>
                <strong>Modo preview</strong>
                <p class="mb-0">Visão do estudante. O aluno tem @seconds s por pergunta e só uma tentativa.</p>
            </div>
        </div>
    }
    else if (showResults)
    {
        <div class="form-fill-banner is-score" role="status">
            <i class="bi bi-clipboard-check" aria-hidden="true"></i>
            <div>
                @if (Model.ScoreGraded is int graded && graded > 0)
                {
                    <strong>Resultado: @Model.ScoreCorrect acerto(s) · @Model.ScoreIncorrect erro(s)</strong>
                    <p class="mb-0">
                        @graded pergunta(s) com gabarito
                        @if (Model.ScoreBlank > 0)
                        {
                            <text>· @Model.ScoreBlank em branco</text>
                        }
                        · tentativa única
                    </p>
                }
                else
                {
                    <strong>Questionário enviado</strong>
                    <p class="mb-0">As perguntas ainda não têm gabarito configurado — peça à professora para marcar as respostas corretas e o feedback.</p>
                }
            </div>
        </div>
        @if (Model.ScoreGraded is int g && g > 0)
        {
            <div class="form-fill-scoreboard" aria-label="Resumo de acertos e erros">
                <div class="form-fill-score-pill is-ok">
                    <span>Acertos</span>
                    <strong>@Model.ScoreCorrect</strong>
                </div>
                <div class="form-fill-score-pill is-bad">
                    <span>Erros</span>
                    <strong>@Model.ScoreIncorrect</strong>
                </div>
                <div class="form-fill-score-pill is-muted">
                    <span>Total</span>
                    <strong>@g</strong>
                </div>
            </div>
        }
    }
    else if (isTimedRun)
    {
        <div class="form-fill-banner is-info" role="status">
            <i class="bi bi-stopwatch" aria-hidden="true"></i>
            <div>
                <strong>Cronômetro ativo</strong>
                <p class="mb-0">@seconds segundos por pergunta. Ao acabar o tempo, passa automaticamente. Só uma chance de envio.</p>
            </div>
        </div>
    }

    @if (isTimedRun)
    {
        <div class="form-fill-timer" id="form-fill-timer" aria-live="polite">
            <div class="form-fill-timer-meta">
                <span id="form-fill-progress">Pergunta 1 de @total</span>
                <strong id="form-fill-countdown">@seconds s</strong>
            </div>
            <div class="form-fill-timer-track" aria-hidden="true">
                <div class="form-fill-timer-bar" id="form-fill-timer-bar"></div>
            </div>
        </div>
    }

    <form asp-action="Fill" asp-route-id="@Model.FormId" method="post" class="form-fill-shell" id="form-fill" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="FormId" value="@Model.FormId" />
        <div asp-validation-summary="ModelOnly" class="form-fill-errors text-danger"></div>

        @for (var i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            var cardState = showResults && q.IsCorrect == true ? "is-correct"
                : showResults && q.IsCorrect == false ? "is-incorrect"
                : "";
            var hideTimed = isTimedRun && i > 0;
            <article class="form-fill-card @cardState @(hideTimed ? "is-hidden-step" : null)"
                     data-question-index="@i"
                     @(hideTimed ? "hidden" : null)>
                <header class="form-fill-card-head">
                    <span class="form-fill-num" aria-hidden="true">@(i + 1)</span>
                    <div class="form-fill-card-title">
                        <h2>@q.Prompt</h2>
                        <p class="form-fill-hint">
                            @TypeHint(q.Type)
                            @if (showResults && q.HasGrading && q.IsCorrect == true)
                            {
                                <span class="form-result-chip is-ok">Certa</span>
                            }
                            else if (showResults && q.HasGrading && q.IsCorrect == false)
                            {
                                <span class="form-result-chip is-bad">Errada</span>
                            }
                            else if (showResults && !q.HasGrading)
                            {
                                <span class="form-result-chip is-muted">Sem gabarito</span>
                            }
                        </p>
                    </div>
                </header>

                <input type="hidden" name="Questions[@i].QuestionId" value="@q.QuestionId" />
                <input type="hidden" name="Questions[@i].Type" value="@q.Type" />
                <input type="hidden" name="Questions[@i].IsRequired" value="false" />
                <input type="hidden" name="Questions[@i].Prompt" value="@q.Prompt" />

                <div class="form-fill-card-body">
                    @switch (q.Type)
                    {
                        case FormQuestionType.ShortText:
                            <input class="form-control form-fill-input" name="Questions[@i].TextValue" value="@q.TextValue"
                                   maxlength="500" autocomplete="off"
                                   placeholder="Digite sua resposta"
                                   aria-label="@q.Prompt"
                                   @(isLocked ? "readonly" : null) />
                            break;
                        case FormQuestionType.Paragraph:
                            <textarea class="form-control form-fill-input" name="Questions[@i].TextValue" rows="5"
                                      maxlength="4000" placeholder="Escreva com detalhes…"
                                      aria-label="@q.Prompt"
                                      @(isLocked ? "readonly" : null)>@q.TextValue</textarea>
                            break;
                        case FormQuestionType.SingleChoice:
                            <div class="form-fill-options" role="radiogroup" aria-label="@q.Prompt">
                                @for (var oi = 0; oi < q.Options.Count; oi++)
                                {
                                    var opt = q.Options[oi];
                                    var optId = $"q{q.QuestionId:N}-o{oi}";
                                    var selected = q.SelectedOptions.Contains(opt);
                                    var isAnswer = q.CorrectOptions.Contains(opt);
                                    var optClass = "";
                                    if (showResults && q.HasGrading)
                                    {
                                        if (isAnswer) optClass = "is-correct";
                                        else if (selected) optClass = "is-incorrect";
                                    }
                                    else if (showResults && selected)
                                    {
                                        optClass = "is-selected";
                                    }
                                    <label class="form-fill-option @optClass" for="@optId">
                                        <input type="radio"
                                               name="Questions[@i].SelectedOptions" value="@opt" id="@optId"
                                               @(selected ? "checked" : null)
                                               @(isLocked ? "disabled" : null) />
                                        <span class="form-fill-option-mark" aria-hidden="true"></span>
                                        <span class="form-fill-option-text">
                                            @opt
                                            @if (showResults && q.HasGrading && isAnswer)
                                            {
                                                <em class="form-fill-opt-tag is-ok">gabarito</em>
                                            }
                                            else if (showResults && selected && q.HasGrading && !isAnswer)
                                            {
                                                <em class="form-fill-opt-tag is-bad">sua escolha</em>
                                            }
                                        </span>
                                    </label>
                                }
                            </div>
                            break;
                        case FormQuestionType.MultiChoice:
                            <div class="form-fill-options" role="group" aria-label="@q.Prompt">
                                @for (var oi = 0; oi < q.Options.Count; oi++)
                                {
                                    var opt = q.Options[oi];
                                    var optId = $"q{q.QuestionId:N}-o{oi}";
                                    var selected = q.SelectedOptions.Contains(opt);
                                    var isAnswer = q.CorrectOptions.Contains(opt);
                                    var optClass = "";
                                    if (showResults && q.HasGrading)
                                    {
                                        if (isAnswer) optClass = "is-correct";
                                        else if (selected) optClass = "is-incorrect";
                                    }
                                    else if (showResults && selected)
                                    {
                                        optClass = "is-selected";
                                    }
                                    <label class="form-fill-option is-multi @optClass" for="@optId">
                                        <input type="checkbox"
                                               name="Questions[@i].SelectedOptions" value="@opt" id="@optId"
                                               @(selected ? "checked" : null)
                                               @(isLocked ? "disabled" : null) />
                                        <span class="form-fill-option-mark" aria-hidden="true"></span>
                                        <span class="form-fill-option-text">
                                            @opt
                                            @if (showResults && q.HasGrading && isAnswer)
                                            {
                                                <em class="form-fill-opt-tag is-ok">gabarito</em>
                                            }
                                        </span>
                                    </label>
                                }
                            </div>
                            break;
                    }

                    @if (showResults)
                    {
                        @if (q.HasGrading)
                        {
                            var feedback = q.FeedbackShown;
                            if (!string.IsNullOrWhiteSpace(feedback))
                            {
                                <div class="form-feedback @(q.IsCorrect == true ? "is-ok" : "is-bad") mt-3">
                                    <strong>@(q.IsCorrect == true ? "Feedback" : "Feedback")</strong>
                                    <p class="mb-0">@feedback</p>
                                </div>
                            }
                            @if (q.IsCorrect == false && q.Type is FormQuestionType.ShortText or FormQuestionType.Paragraph)
                            {
                                <p class="form-fill-key mt-2 mb-0">
                                    Gabarito: <strong>@string.Join(" · ", q.CorrectOptions)</strong>
                                </p>
                            }
                            @if (!q.WasAnswered)
                            {
                                <p class="form-fill-key mt-2 mb-0">Você não respondeu a tempo.</p>
                            }
                        }
                        else
                        {
                            <div class="form-feedback is-muted mt-3">
                                Sem gabarito nesta pergunta — a professora ainda não marcou a resposta correta.
                            </div>
                        }
                    }
                </div>
            </article>
        }

        <div class="form-fill-actions">
            @if (Model.IsTeacherPreview)
            {
                <button type="button" class="btn btn-primary btn-lg" disabled>Enviar (preview)</button>
            }
            else if (isLocked)
            {
                <p class="form-fill-actions-note mb-0">Resultado bloqueado — tentativa única.</p>
            }
            else if (isTimedRun)
            {
                <button type="button" class="btn btn-primary btn-lg" id="form-fill-next">Próxima pergunta</button>
                <button type="submit" class="btn btn-primary btn-lg" id="form-fill-submit" hidden>Enviar respostas</button>
                <p class="form-fill-actions-note mb-0">Ou aguarde o tempo acabar para avançar automaticamente.</p>
            }
            else
            {
                <button type="submit" class="btn btn-primary btn-lg" id="form-fill-submit">Enviar respostas</button>
            }
        </div>
    </form>
</div>

@section Scripts {
    @if (isTimedRun)
    {
        <script>
            (() => {
                const page = document.querySelector('.form-fill-page');
                const form = document.getElementById('form-fill');
                const cards = [...form.querySelectorAll('.form-fill-card')];
                const nextBtn = document.getElementById('form-fill-next');
                const submitBtn = document.getElementById('form-fill-submit');
                const progressEl = document.getElementById('form-fill-progress');
                const countdownEl = document.getElementById('form-fill-countdown');
                const barEl = document.getElementById('form-fill-timer-bar');
                const total = cards.length;
                const secondsPer = Number(page.dataset.seconds || 40);
                let index = 0;
                let remaining = secondsPer;
                let timerId = null;
                let submitting = false;

                function show(i) {
                    cards.forEach((card, n) => {
                        const on = n === i;
                        card.hidden = !on;
                        card.classList.toggle('is-hidden-step', !on);
                    });
                    progressEl.textContent = `Pergunta ${i + 1} de ${total}`;
                    const last = i >= total - 1;
                    nextBtn.hidden = last;
                    nextBtn.textContent = 'Próxima pergunta';
                    submitBtn.hidden = !last;
                    if (last) submitBtn.textContent = 'Enviar respostas';
                }

                function paintTimer() {
                    countdownEl.textContent = `${remaining} s`;
                    const pct = Math.max(0, (remaining / secondsPer) * 100);
                    barEl.style.width = pct + '%';
                    barEl.classList.toggle('is-urgent', remaining <= 8);
                }

                function clearTimer() {
                    if (timerId) {
                        clearInterval(timerId);
                        timerId = null;
                    }
                }

                function startTimer() {
                    clearTimer();
                    remaining = secondsPer;
                    paintTimer();
                    timerId = setInterval(() => {
                        remaining -= 1;
                        paintTimer();
                        if (remaining <= 0) {
                            clearTimer();
                            advance(true);
                        }
                    }, 1000);
                }

                function advance(fromTimeout) {
                    if (submitting) return;
                    if (index >= total - 1) {
                        finish();
                        return;
                    }
                    index += 1;
                    show(index);
                    startTimer();
                    if (fromTimeout) {
                        countdownEl.textContent = `${secondsPer} s`;
                    }
                }

                function finish() {
                    if (submitting) return;
                    submitting = true;
                    clearTimer();
                    nextBtn.disabled = true;
                    submitBtn.disabled = true;
                    submitBtn.hidden = false;
                    submitBtn.textContent = 'Enviando…';
                    // disabled radios/checkboxes are not posted — leave enabled until submit
                    form.requestSubmit ? form.requestSubmit() : form.submit();
                }

                nextBtn?.addEventListener('click', () => advance(false));
                form.addEventListener('submit', () => {
                    submitting = true;
                    clearTimer();
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.textContent = 'Enviando…';
                    }
                });

                show(0);
                startTimer();
            })();
        </script>
    }
}
