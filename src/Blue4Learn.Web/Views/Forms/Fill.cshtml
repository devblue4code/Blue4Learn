@model FormFillViewModel
@{
    ViewData["Title"] = Model.IsTeacherPreview ? $"Preview · {Model.Title}" : Model.Title;
    ViewData["TopTitle"] = "Atividades";
    var showResults = Model.ShowResults && !Model.IsTeacherPreview;
}

<div class="page-header">
    <div>
        <p class="eyebrow">@Model.LessonContext · @Model.LessonTitle</p>
        <h1>@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="section-lead">@Model.Description</p>
        }
        @if (Model.IsTeacherPreview)
        {
            <p class="small text-muted mb-0">Preview como o estudante vê — as respostas não são enviadas.</p>
        }
        else if (showResults && Model.ScoreGraded is int graded && graded > 0)
        {
            <p class="mb-0">
                Resultado:
                <strong>@Model.ScoreCorrect / @graded</strong> corretas
            </p>
        }
        else if (Model.AlreadyResponded)
        {
            <p class="small text-muted mb-0">Você já enviou respostas — pode atualizar e enviar de novo.</p>
        }
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.IsTeacherPreview)
        {
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.FormId">Construtor</a>
            <a class="btn btn-outline-primary" asp-controller="Lessons" asp-action="Workspace" asp-route-id="@Model.LessonId">Ver aula</a>
        }
        <a class="btn btn-outline-primary" asp-action="Index" asp-route-lessonId="@Model.LessonId">Voltar</a>
    </div>
</div>

@if (Model.IsTeacherPreview)
{
    <div class="alert alert-info soft-panel mb-3" role="status">
        Você está no <strong>modo preview</strong>. Experimente as perguntas; o envio fica desativado.
    </div>
}

<form asp-action="Fill" method="post" class="soft-panel" style="max-width: 720px">
    @Html.AntiForgeryToken()
    <input type="hidden" name="FormId" value="@Model.FormId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @for (var i = 0; i < Model.Questions.Count; i++)
    {
        var q = Model.Questions[i];
        <input type="hidden" name="Questions[@i].QuestionId" value="@q.QuestionId" />
        <input type="hidden" name="Questions[@i].Type" value="@q.Type" />
        <input type="hidden" name="Questions[@i].IsRequired" value="@q.IsRequired" />
        <input type="hidden" name="Questions[@i].Prompt" value="@q.Prompt" />

        <fieldset class="mb-4 form-fill-question @(showResults && q.IsCorrect == true ? "is-correct" : null) @(showResults && q.IsCorrect == false ? "is-incorrect" : null)">
            <legend class="h6 mb-2">
                @(i + 1). @q.Prompt
                @if (q.IsRequired)
                {
                    <span class="text-danger">*</span>
                }
                @if (showResults && q.IsCorrect == true)
                {
                    <span class="form-result-chip is-ok">Certa</span>
                }
                else if (showResults && q.IsCorrect == false)
                {
                    <span class="form-result-chip is-bad">Errada</span>
                }
            </legend>

            @switch (q.Type)
            {
                case FormQuestionType.ShortText:
                    <input class="form-control" name="Questions[@i].TextValue" value="@q.TextValue"
                           maxlength="500"
                           @(Model.IsTeacherPreview ? null : (q.IsRequired ? "required" : null)) />
                    break;
                case FormQuestionType.Paragraph:
                    <textarea class="form-control" name="Questions[@i].TextValue" rows="4"
                              maxlength="4000"
                              @(Model.IsTeacherPreview ? null : (q.IsRequired ? "required" : null))>@q.TextValue</textarea>
                    break;
                case FormQuestionType.SingleChoice:
                    @foreach (var opt in q.Options)
                    {
                        var optId = $"q{i}-{opt.GetHashCode()}";
                        var selected = q.SelectedOptions.Contains(opt);
                        var isAnswer = q.CorrectOptions.Contains(opt);
                        var optClass = "";
                        if (showResults && q.HasGrading)
                        {
                            if (isAnswer) optClass = "form-option is-correct";
                            else if (selected) optClass = "form-option is-incorrect";
                        }
                        <div class="form-check @optClass">
                            <input class="form-check-input" type="radio"
                                   name="Questions[@i].SelectedOptions" value="@opt" id="@optId"
                                   @(selected ? "checked" : null)
                                   @(Model.IsTeacherPreview ? null : (q.IsRequired ? "required" : null)) />
                            <label class="form-check-label" for="@optId">@opt</label>
                        </div>
                    }
                    break;
                case FormQuestionType.MultiChoice:
                    @foreach (var opt in q.Options)
                    {
                        var optId = $"q{i}-{opt.GetHashCode()}";
                        var selected = q.SelectedOptions.Contains(opt);
                        var isAnswer = q.CorrectOptions.Contains(opt);
                        var optClass = "";
                        if (showResults && q.HasGrading)
                        {
                            if (isAnswer) optClass = "form-option is-correct";
                            else if (selected) optClass = "form-option is-incorrect";
                        }
                        <div class="form-check @optClass">
                            <input class="form-check-input" type="checkbox"
                                   name="Questions[@i].SelectedOptions" value="@opt" id="@optId"
                                   @(selected ? "checked" : null) />
                            <label class="form-check-label" for="@optId">@opt</label>
                        </div>
                    }
                    break;
            }

            @if (showResults && q.HasGrading)
            {
                if (q.IsCorrect == true && !string.IsNullOrWhiteSpace(q.FeedbackCorrect))
                {
                    <div class="form-feedback is-ok mt-2">@q.FeedbackCorrect</div>
                }
                else if (q.IsCorrect == false)
                {
                    @if (!string.IsNullOrWhiteSpace(q.FeedbackIncorrect))
                    {
                        <div class="form-feedback is-bad mt-2">@q.FeedbackIncorrect</div>
                    }
                    @if (q.Type is FormQuestionType.ShortText or FormQuestionType.Paragraph)
                    {
                        <p class="small text-muted mt-2 mb-0">
                            Gabarito:
                            <strong>@string.Join(" · ", q.CorrectOptions)</strong>
                        </p>
                    }
                }
            }
        </fieldset>
    }

    @if (Model.IsTeacherPreview)
    {
        <button type="button" class="btn btn-primary" disabled>Enviar respostas (preview)</button>
    }
    else
    {
        <button type="submit" class="btn btn-primary">@(Model.AlreadyResponded ? "Atualizar respostas" : "Enviar respostas")</button>
    }
</form>
