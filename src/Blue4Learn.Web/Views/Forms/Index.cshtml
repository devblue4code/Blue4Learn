@model FormListViewModel
@{
    ViewData["Title"] = "Atividades";
    ViewData["TopTitle"] = "Atividades";
}

<div class="page-header">
    <div>
        <p class="eyebrow">@(Model.IsTeacher ? "Por aula" : "Participação")</p>
        <h1>Atividades</h1>
        <p class="section-lead">
            @if (!string.IsNullOrWhiteSpace(Model.FilterLessonTitle))
            {
                <text>Questionários da aula <strong>@Model.FilterLessonTitle</strong>.</text>
            }
            else if (Model.IsTeacher)
            {
                <text>Crie formulários vinculados a uma aula — perguntas no estilo Forms.</text>
            }
            else
            {
                <text>Responda às atividades publicadas nas suas aulas.</text>
            }
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.FilterLessonId is Guid lid)
        {
            <a class="btn btn-outline-primary" asp-action="Index">Todas as aulas</a>
            @if (Model.IsTeacher)
            {
                <a class="btn btn-primary" asp-action="Create" asp-route-lessonId="@lid">Nova nesta aula</a>
            }
            else
            {
                <a class="btn btn-outline-primary" asp-controller="Lessons" asp-action="Workspace" asp-route-id="@lid">Abrir aula</a>
            }
        }
        else if (Model.IsTeacher)
        {
            <a class="btn btn-primary" asp-action="Create">Nova atividade</a>
        }
    </div>
</div>

@if (!Model.Forms.Any())
{
    <div class="soft-panel dash-empty">
        <h3>@(Model.IsTeacher ? "Nenhuma atividade ainda" : "Nada publicado no momento")</h3>
        <p class="mb-0 text-muted">
            @(Model.IsTeacher
                ? "Crie a primeira vinculada a uma aula e monte as perguntas."
                : "Quando a professora publicar um questionário na aula, ele aparece aqui.")
        </p>
        @if (Model.IsTeacher)
        {
            <a class="btn btn-primary mt-3" asp-action="Create" asp-route-lessonId="@Model.FilterLessonId">Criar atividade</a>
        }
    </div>
}
else
{
    <div class="components-grid">
        @foreach (var form in Model.Forms)
        {
            <article class="soft-panel">
                <div class="d-flex justify-content-between gap-2 flex-wrap align-items-start mb-2">
                    <span class="prog-chip @(form.IsPublished ? null : "is-muted")">
                        @(form.IsPublished ? "Publicada" : "Rascunho")
                    </span>
                    <span class="small text-muted">@form.LessonContext</span>
                </div>
                <h2 class="h5">@form.Title</h2>
                <p class="small mb-1"><strong>Aula:</strong> @form.LessonTitle</p>
                @if (!string.IsNullOrWhiteSpace(form.Description))
                {
                    <p class="text-muted">@form.Description</p>
                }
                <p class="small text-muted mb-3">
                    @form.QuestionCount pergunta(s)
                    @if (Model.IsTeacher)
                    {
                        <text>· @form.ResponseCount resposta(s)</text>
                    }
                    else if (form.AlreadyResponded)
                    {
                        <text>· você já respondeu</text>
                    }
                </p>
                @if (Model.IsTeacher)
                {
                    <div class="d-flex gap-2 flex-wrap">
                        <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@form.Id">Construtor</a>
                        <a class="btn btn-outline-primary btn-sm" asp-action="Preview" asp-route-id="@form.Id">Preview</a>
                        <a class="btn btn-outline-primary btn-sm" asp-action="Responses" asp-route-id="@form.Id">Respostas</a>
                    </div>
                }
                else
                {
                    <a class="btn @(form.AlreadyResponded ? "btn-outline-primary" : "btn-primary")"
                       asp-action="Fill" asp-route-id="@form.Id">
                        @(form.AlreadyResponded ? "Ver resultado" : "Responder · 40s/pergunta")
                    </a>
                }
            </article>
        }
    </div>
}
