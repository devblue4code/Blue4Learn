@model FormResponsesViewModel
@{
    ViewData["Title"] = $"Respostas · {Model.Title}";
    ViewData["TopTitle"] = "Atividades";
}

<div class="page-header">
    <div>
        <p class="eyebrow">@Model.LessonContext · @Model.LessonTitle</p>
        <h1>Respostas · @Model.Title</h1>
        <p class="section-lead">@Model.Responses.Count envio(s) · @Model.QuestionCount pergunta(s).</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.FormId">Construtor</a>
        <a class="btn btn-outline-primary" asp-action="Index">Lista</a>
    </div>
</div>

@if (!Model.Responses.Any())
{
    <div class="soft-panel dash-empty">
        <h3>Ainda sem respostas</h3>
        <p class="mb-0 text-muted">Quando os alunos enviarem, os envios aparecem aqui.</p>
    </div>
}
else
{
    <div class="table-responsive soft-panel">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Estudante</th>
                    <th>Enviado em</th>
                    <th>Respostas</th>
                    <th>Acertos</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Responses)
                {
                    <tr>
                        <td>@r.StudentName</td>
                        <td>@r.SubmittedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@r.AnsweredCount / @Model.QuestionCount</td>
                        <td>
                            @if (r.GradedCount is int g && g > 0)
                            {
                                <text>@r.CorrectCount / @g</text>
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="ResponseDetail" asp-route-id="@r.ResponseId">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
