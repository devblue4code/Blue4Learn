@model LessonWorkspaceViewModel
@{
    ViewData["Title"] = $"Atividade · {Model.Title}";
    ViewData["WorkspaceSection"] = "activity";
    var activity = Model.Activity;
    var isReviewed = activity?.Status == ActivityStatus.Reviewed;
    string ActivityStatusLabel(ActivityStatus status) => status switch
    {
        ActivityStatus.NotStarted => "Não iniciada",
        ActivityStatus.InProgress => "Em andamento",
        ActivityStatus.Submitted => "Enviada",
        ActivityStatus.Reviewed => "Corrigida",
        _ => status.ToString()
    };
}

<article class="ws ws-page">
    <partial name="_WorkspaceHeader" model="Model" />
    <partial name="_WorkspaceRiskBanner" model="Model" />
    <div class="ws-layout">
        <partial name="_WorkspaceNav" model="Model" />
        <div class="ws-main-col">
    @if (activity is null)
    {
        <section class="soft-panel ws-panel ws-page-form">
            <div class="ws-panel-head">
                <h2>Atividade</h2>
                <p>Esta aula ainda não tem atividade publicada.</p>
            </div>
            <a class="btn btn-outline-primary" asp-action="Workspace" asp-route-id="@Model.LessonId">Voltar ao conteúdo</a>
        </section>
    }
    else
    {
        <form asp-action="SaveActivity" method="post" class="soft-panel activity-form ws-panel ws-page-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="lessonId" value="@Model.LessonId" />
            <input type="hidden" name="returnTo" value="activity" />
            <input type="hidden" name="ActivityId" value="@activity.ActivityId" />
            @if (!activity.RequiresGitHubDelivery)
            {
                <input type="hidden" name="GitHubUrl" value="@activity.GitHubUrl" />
                <input type="hidden" name="GitHubPrUrl" value="@activity.GitHubPrUrl" />
                <input type="hidden" name="DeliveryNote" value="@activity.DeliveryNote" />
            }
            else
            {
                <input type="hidden" name="TextResponse" value="@activity.TextResponse" />
            }

            <div class="ws-panel-head">
                <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                    <div>
                        <h2>Atividade prática</h2>
                        <p>@activity.Title</p>
                    </div>
                    <span class="prog-chip @(isReviewed ? null : activity.Status == ActivityStatus.Submitted ? "is-warn" : "is-muted")">
                        @ActivityStatusLabel(activity.Status)
                    </span>
                </div>
            </div>

            <div class="ws-activity-prompt markdown-body">
                @Html.Raw(activity.PromptHtml)
            </div>
            @if (activity.DueAtUtc is DateTime due)
            {
                <p class="ws-hint mb-3">Prazo: @due.ToLocalTime().ToString("dd/MM/yyyy")</p>
            }

            @if (isReviewed)
            {
                <div class="callout callout-feedback mb-3">
                    <strong>Revisada pela professora</strong>
                    <p class="mb-0">Seu envio ficou registrado. O feedback dela não pode ser alterado por você.</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(activity.TeacherFeedback))
            {
                <div class="callout callout-feedback mb-3">
                    <strong>Feedback da professora</strong>
                    <p class="mb-0">@activity.TeacherFeedback</p>
                </div>
            }

            @if (activity.RequiresGitHubDelivery)
            {
                <div class="callout mb-3">
                    <strong>Entrega via GitHub</strong>
                    <p class="mb-0">Informe o repositório. O Pull Request e um recado curto são opcionais.</p>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="GitHubUrl">URL do repositório <span class="text-danger">*</span></label>
                    <input id="GitHubUrl" name="GitHubUrl" class="form-control" value="@activity.GitHubUrl"
                           placeholder="https://github.com/usuario/repositorio" required @(isReviewed ? "disabled" : null) />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="GitHubPrUrl">URL do Pull Request (opcional)</label>
                    <input id="GitHubPrUrl" name="GitHubPrUrl" class="form-control" value="@activity.GitHubPrUrl"
                           placeholder="https://github.com/usuario/repositorio/pull/1" @(isReviewed ? "disabled" : null) />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="DeliveryNote">Recado para a professora (opcional)</label>
                    <textarea id="DeliveryNote" name="DeliveryNote" class="form-control" rows="2" maxlength="500"
                              placeholder="Ex.: branch feature/login, pendências conhecidas…" @(isReviewed ? "disabled" : null)>@activity.DeliveryNote</textarea>
                </div>
            }

            <div class="mb-3">
                <label class="form-label" for="ProblemDescription">Descrição do problema</label>
                <textarea id="ProblemDescription" name="ProblemDescription" class="form-control" rows="3"
                          @(isReviewed ? "disabled" : null)>@activity.ProblemDescription</textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" for="SolutionDescription">Descrição da solução</label>
                <textarea id="SolutionDescription" name="SolutionDescription" class="form-control" rows="3"
                          @(isReviewed ? "disabled" : null)>@activity.SolutionDescription</textarea>
            </div>

            @if (!isReviewed)
            {
                <button type="submit" class="btn btn-primary">Salvar atividade</button>
            }
            else
            {
                <a class="btn btn-outline-primary" asp-action="Evidence" asp-route-id="@Model.LessonId">Ver evidências</a>
            }
        </form>

        @if (Model.NextStepKey != "activity")
        {
            <partial name="_WorkspaceNextStep" model="Model" />
        }
    }
        </div>
    </div>
</article>
