@model IReadOnlyList<LessonSummaryViewModel>
@{
    ViewData["Title"] = "Conteúdos";
}

<div class="page-header">
    <div>
        <p class="eyebrow">Programação Web</p>
        <h1>Conteúdos</h1>
        <p class="section-lead">Leia no celular ou no computador e registre a aprendizagem em cada aula.</p>
    </div>
</div>

<div class="lesson-list">
@foreach (var lesson in Model)
{
    <a class="lesson-row" asp-action="Workspace" asp-route-id="@lesson.Id">
        <span class="lesson-order">@lesson.SortOrder</span>
        <span class="lesson-meta">
            <strong>@lesson.Title</strong>
            <small>@lesson.ModuleTitle · @lesson.Objective</small>
        </span>
        <span class="lesson-status @(lesson.HasJournal ? "is-done" : "")">
            @(lesson.HasJournal ? "Registrado" : "Abrir aula")
        </span>
    </a>
}
</div>
