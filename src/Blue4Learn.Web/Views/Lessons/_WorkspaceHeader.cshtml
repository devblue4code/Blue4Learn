@model LessonWorkspaceViewModel
@{
    ViewData["ShowCrumbs"] = true;
    ViewData["CrumbParent"] = Model.ModuleTitle;
    ViewData["CrumbCurrent"] = Model.Title;
    ViewData["LessonId"] = Model.LessonId;
}

<header class="ws-page-head">
    <div>
        <p class="eyebrow">@Model.CourseTitle · @Model.ModuleTitle</p>
        <h1>@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Objective))
        {
            <p class="ws-objective"><span>Objetivo</span> @Model.Objective</p>
        }
        <p class="ws-learning-pct">
            <span>Seu progresso nesta aula</span>
            <strong>@Model.LessonLearningPercent%</strong>
        </p>
    </div>
</header>
