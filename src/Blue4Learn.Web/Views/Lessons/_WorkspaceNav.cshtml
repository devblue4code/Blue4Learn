@model LessonWorkspaceViewModel
@{
    var section = ViewData["WorkspaceSection"] as string ?? "content";
    string NavClass(string key) => section == key ? "ws-side-link is-active" : "ws-side-link";
    string BadgeClass(bool done, bool warn = false, bool started = false)
    {
        if (warn) return "ws-tool-badge is-warn";
        if (done) return "ws-tool-badge is-done";
        if (started) return "ws-tool-badge is-progress";
        return "ws-tool-badge";
    }
}

<nav class="ws-side-nav" aria-label="Áreas da aula">
    <p class="ws-side-label">Nesta aula</p>
    <a class="@NavClass("content")" asp-action="Workspace" asp-route-id="@Model.LessonId">
        <i class="bi bi-file-text" aria-hidden="true"></i>
        <span>Conteúdo</span>
    </a>
    <a class="@NavClass("journal")" asp-action="Journal" asp-route-id="@Model.LessonId"
       title="@(Model.JournalNeedsAttention ? "Registro — precisa revisar" : Model.JournalDone ? "Registro salvo" : "Meu registro")">
        <i class="bi bi-journal-text" aria-hidden="true"></i>
        <span>Registro</span>
        <span class="@BadgeClass(Model.JournalDone, Model.JournalNeedsAttention)" aria-hidden="true"></span>
    </a>
    <a class="@NavClass("activity")" asp-action="Activity" asp-route-id="@Model.LessonId"
       title="@(Model.ActivityDone ? "Atividade concluída" : Model.ActivityStarted ? "Atividade em andamento" : "Atividade")">
        <i class="bi bi-check2-square" aria-hidden="true"></i>
        <span>Atividade</span>
        @if (Model.Activity is not null)
        {
            <span class="@BadgeClass(Model.ActivityDone, started: Model.ActivityStarted && !Model.ActivityDone)" aria-hidden="true"></span>
        }
    </a>
    <a class="@NavClass("evidence")" asp-action="Evidence" asp-route-id="@Model.LessonId"
       title="@(Model.EvidenceDone ? "Evidência enviada" : "Evidências")">
        <i class="bi bi-paperclip" aria-hidden="true"></i>
        <span>Evidências</span>
        @if (Model.Activity is not null)
        {
            <span class="@BadgeClass(Model.EvidenceDone)" aria-hidden="true"></span>
        }
    </a>
</nav>
