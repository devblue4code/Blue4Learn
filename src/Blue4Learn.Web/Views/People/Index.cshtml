@model PeopleListViewModel
@{
    ViewData["Title"] = "Pessoas";
    ViewData["ShowCrumbs"] = true;
    ViewData["CrumbParent"] = "Administração";
    ViewData["CrumbCurrent"] = "Pessoas";
}

<div class="page-header">
    <div>
        <p class="eyebrow">Administração</p>
        <h1>Pessoas</h1>
        <p class="section-lead">Gerencie perfis, atribua professoras às disciplinas e matricule em turmas.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-plus-lg me-1"></i> Nova pessoa
    </a>
</div>

@if (!Model.People.Any())
{
    <div class="soft-panel">
        <p class="mb-0 text-muted">Nenhuma pessoa neste tenant ainda.</p>
    </div>
}
else
{
    <div class="data-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Perfil</th>
                        <th>Disciplina</th>
                        <th>Turmas</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var person in Model.People)
                {
                    <tr>
                        <td>
                            <strong class="text-body">@person.FullName</strong>
                            <div class="small text-muted">@person.Email</div>
                        </td>
                        <td>@person.RoleLabel</td>
                        <td>@(string.IsNullOrWhiteSpace(person.CourseTitle) ? "—" : person.CourseTitle)</td>
                        <td>@person.ClassCount</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@person.Id">Editar</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="data-card-footer">
            <span>@Model.People.Count pessoa@(Model.People.Count == 1 ? "" : "s")</span>
        </div>
    </div>
}
