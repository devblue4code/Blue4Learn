@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isLanding = (ViewData["BodyClass"] as string)?.Contains("is-landing", StringComparison.Ordinal) == true;
    string NavClass(string ctrl, string? act = null) =>
        string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase)
        && (act is null || string.Equals(action, act, StringComparison.OrdinalIgnoreCase))
            ? "nav-link is-active"
            : "nav-link";
    var classesManageActive =
        string.Equals(controller, "Classes", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(action, "Join", StringComparison.OrdinalIgnoreCase)
            ? "nav-link is-active"
            : "nav-link";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Início") · Blue4Learn</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/favicon-32.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:opsz,wght@9..144,560;9..144,650&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewData["BodyClass"] as string)">
    <header class="site-header">
        <nav class="navbar navbar-expand-lg site-nav">
            <div class="container site-nav-inner">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">B4</span>
                    <span class="brand-copy">
                        <span class="brand-text">Blue4Learn</span>
                        <span class="brand-tag">Diário de bordo</span>
                    </span>
                </a>

                <button class="nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Abrir menu">
                    <span></span><span></span><span></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="nav-cluster">
                            <a class="@NavClass("Home", "Dashboard")" asp-controller="Home" asp-action="Dashboard">Início</a>
                            <a class="@NavClass("Lessons")" asp-controller="Lessons" asp-action="Index">Conteúdos</a>
                            <a class="@NavClass("Progress")" asp-controller="Progress" asp-action="Index">Meu diário</a>
                            @if (!User.IsInRole(AppRoles.Teacher) && !User.IsInRole(AppRoles.Admin))
                            {
                                <a class="@NavClass("Classes", "Join")" asp-controller="Classes" asp-action="Join">Entrar na turma</a>
                            }
                        </div>

                        @if (User.IsInRole(AppRoles.Teacher) || User.IsInRole(AppRoles.Admin))
                        {
                            <div class="nav-cluster nav-cluster-teacher">
                                <span class="nav-cluster-label">Docência</span>
                                <a class="@classesManageActive" asp-controller="Classes" asp-action="Index">Turmas</a>
                                <a class="@NavClass("Content")" asp-controller="Content" asp-action="Index">Publicar</a>
                                <a class="@NavClass("Teacher")" asp-controller="Teacher" asp-action="Dashboard">Painel</a>
                            </div>
                        }
                    }
                    <div class="nav-account ms-lg-auto">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="site-main @(isLanding ? "site-main-landing" : null)">
        @if (isLanding)
        {
            @RenderBody()
        }
        else
        {
            <div class="container py-4">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success alert-soft" role="status">@success</div>
                }
                @if (TempData["Info"] is string info)
                {
                    <div class="alert alert-info alert-soft" role="status">@info</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-soft" role="alert">@error</div>
                }
                @RenderBody()
            </div>
        }
    </main>

    <footer class="site-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <span>Blue4Learn · Diário de Bordo Digital · Blue4Code</span>
            <a asp-controller="Home" asp-action="Privacy">Privacidade</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
