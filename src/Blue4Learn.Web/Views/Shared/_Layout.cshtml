@{
    var isLanding = (ViewData["BodyClass"] as string)?.Contains("is-landing", StringComparison.Ordinal) == true;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var bodyClass = $"{ViewData["BodyClass"] as string} {(isAuthenticated ? "is-authenticated app-body" : "app-body")}".Trim();
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Início") · Blue4Learn</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/favicon-32.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Manrope:wght@600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css" />
    <link rel="stylesheet" href="~/css/app-shell.css" asp-append-version="true" />
    <script>
        (function () {
            try {
                var t = localStorage.getItem('b4l-theme');
                if (t !== 'light' && t !== 'dark') {
                    t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@bodyClass">
@if (isAuthenticated && !isLanding)
{
    <div class="app-shell" data-app-shell>
        <div class="app-side-backdrop" data-app-nav-close></div>
        <partial name="_SideNav" />
        <div class="app-main">
            <partial name="_TopAppBar" />
            <main class="app-canvas">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success alert-soft" role="status">@success</div>
                }
                @if (TempData["Info"] is string info)
                {
                    <div class="alert alert-info alert-soft" role="status">@info</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-soft" role="alert">@error</div>
                }
                @RenderBody()
            </main>
            <footer class="app-footer">
                <span>Blue4Learn · Diário de Bordo Digital · Blue4Code</span>
                <a asp-controller="Home" asp-action="Privacy">Privacidade</a>
            </footer>
        </div>
    </div>
}
else
{
    <header class="app-guest-header">
        <div class="app-guest-inner">
            <a class="app-side-brand" style="padding:0" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">B4</span>
                <span>
                    <span class="brand-text">Blue4Learn</span>
                    <span class="brand-tag">Diário de bordo</span>
                </span>
            </a>
            <partial name="_LoginPartial" />
        </div>
    </header>
    <main class="@(isLanding ? "site-main-landing" : "container py-4")">
        @RenderBody()
    </main>
    @if (!isLanding)
    {
        <footer class="app-footer">
            <span>Blue4Learn · Diário de Bordo Digital · Blue4Code</span>
            <a asp-controller="Home" asp-action="Privacy">Privacidade</a>
        </footer>
    }
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
