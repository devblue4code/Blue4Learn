@model SubmissionListViewModel
@{
    ViewData["Title"] = "Atividades enviadas";
    var missingCount = Model.MissingGitHubCount;
}

<div class="page-header">
    <div>
        <p class="eyebrow">@Model.ClassName</p>
        <h1>Atividades e evidências</h1>
        <p class="section-lead">Comente a entrega do estudante sem expor a reflexão privada para a turma.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Dashboard">Voltar ao painel</a>
</div>

<div class="filter-tabs mb-3">
    <a class="@(Model.Filter == "all" ? "active" : null)" asp-action="Submissions" asp-route-filter="all">Todas</a>
    <a class="@(Model.Filter == "missing-github" ? "active" : null)" asp-action="Submissions" asp-route-filter="missing-github">
        Sem GitHub @(missingCount > 0 ? $"({missingCount})" : "")
    </a>
</div>

@if (!Model.Items.Any())
{
    <div class="soft-panel">
        <p class="mb-0 text-muted">
            @(Model.Filter == "missing-github"
                ? "Nenhuma entrega pendente de link do GitHub."
                : "Ainda não há atividades enviadas.")
        </p>
    </div>
}
else
{
    <div class="table-responsive soft-panel">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Estudante</th>
                    <th>Aula</th>
                    <th>Status</th>
                    <th>GitHub</th>
                    <th>Anexos</th>
                    <th>Atualizado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.StudentName</td>
                    <td>
                        <strong>@item.LessonTitle</strong>
                        <div class="small text-muted">@item.ActivityTitle</div>
                    </td>
                    <td>
                        <span class="status-pill @(item.Status == ActivityStatus.Reviewed ? "status-published" : "status-draft")">
                            @item.Status
                        </span>
                        @if (item.HasFeedback)
                        {
                            <div class="small text-muted">com feedback</div>
                        }
                        @if (item.MissingGitHubDelivery)
                        {
                            <div class="small text-danger">sem repositório</div>
                        }
                    </td>
                    <td class="small">
                        @if (!string.IsNullOrWhiteSpace(item.GitHubUrl))
                        {
                            <a href="@item.GitHubUrl" target="_blank" rel="noopener">Repositório</a>
                            @if (!string.IsNullOrWhiteSpace(item.GitHubPrUrl))
                            {
                                <span class="text-muted"> · </span>
                                <a href="@item.GitHubPrUrl" target="_blank" rel="noopener">PR</a>
                            }
                        }
                        else if (item.RequiresGitHubDelivery)
                        {
                            <span class="text-muted">—</span>
                        }
                        else
                        {
                            <span class="text-muted">não exigido</span>
                        }
                    </td>
                    <td>@item.AttachmentCount</td>
                    <td class="small text-muted">@item.UpdatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-primary" asp-action="Review" asp-route-id="@item.SubmissionId">Revisar</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
